{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/migrations/index.ts",
    "src/migrations/*.ts",
    "src/app/(payload)/admin/importMap.js",
    "scripts/*.mjs",
    "eslint-local-rules.mjs",
    "tests/**/*.spec.ts",
    "tests/helpers/serverOnly.ts"
  ],
  "project": ["src/**/*.{ts,tsx,js}", "scripts/**/*.mjs", "tests/**/*.ts"],
  "ignore": [
    "src/components/ui/bubble.tsx",
    "src/components/ui/marker.tsx",
    "src/components/ui/message.tsx"
  ],
  "paths": {
    "server-only": ["tests/helpers/serverOnly.ts"]
  },
  "ignoreBinaries": [],
  "ignoreDependencies": ["tailwindcss-animate", "tw-animate-css", "shadcn", "eslint-config-next"],
  "rules": {
    "exports": "error",
    "types": "error",
    "enumMembers": "error",
    "duplicates": "off"
  }
}
