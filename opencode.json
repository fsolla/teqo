{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "penpot": {
      "type": "remote",
      "url": "https://design.penpot.app/mcp/stream?userToken={file:.opencode/secrets/penpot-token}",
      "enabled": true
    }
  },
  "provider": {
    "cheapest-inference": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cheapest Inference",
      "options": {
        "baseURL": "https://api.cheapestinference.com/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "mimo-v2.5": {
          "name": "MiMo v2.5",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        }
      }
    },
    "vercel": {
      "models": {
        "deepseek/deepseek-v4-flash": {
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    }
  }
}
