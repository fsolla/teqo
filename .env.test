# Environment for the automated test suite (vitest + playwright).
#
# This file is committed ON PURPOSE: it contains no secrets, only local values.
# The test suite deletes and recreates records, so it MUST use an isolated,
# throwaway database. Tests load THIS file (not .env / .env.local) and refuse to
# run unless the database name ends with "_test" (see assertTestDatabase.ts).
#
# Requires the local Postgres from docker-compose (`pnpm db:start`), which
# auto-creates the teqo_test database on first run.
DATABASE_URL=postgresql://teqo:teqo@localhost:5432/teqo_test
PAYLOAD_SECRET=test-only-secret-not-used-in-production
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
