# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

/.idea/*
!/.idea/runConfigurations

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env

/media

# TSE open-data zip cache (pnpm db:seed:tse)
/data/tse/

# Research source deposits (paywalled books/papers obtained legally) — keep only README/NOTES
/docs/research/sources/**
!/docs/research/sources/**/
!/docs/research/sources/README.md
!/docs/research/sources/**/NOTES.md

# IBGE geometry download cache (pnpm build:geometries)
/data/geometries/
# IBGE demographics download cache (pnpm build:demographics)
/data/demographics/

# Transcription intermediates (source audio lives under docs/)
output/**/*.wav

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.playwright-cli/
.aider*
